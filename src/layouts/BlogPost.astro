---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props;

// Coerce empty string / missing values to undefined so BaseHead's fallback engages cleanly
const resolvedHero = heroImage && typeof heroImage === 'object' && 'src' in heroImage ? heroImage : undefined;

// Resolve absolute image URL for og:image and JSON-LD
let absoluteImageUrl: string | undefined;
if (resolvedHero) {
	const optimised = await getImage({ src: resolvedHero, width: 1200, format: 'jpg' });
	absoluteImageUrl = new URL(optimised.src, Astro.site).toString();
}

// BlogPosting JSON-LD
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	...(absoluteImageUrl && { image: absoluteImageUrl }),
	author: {
		'@type': 'Person',
		name: 'Neil Stanley',
		url: new URL('/about/', Astro.site).toString(),
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': new URL(Astro.url.pathname, Astro.site).toString(),
	},
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={resolvedHero} ogType="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(img.float-right) {
				float: right;
				max-width: 50%;
				margin: 0.25em 0 1em 1.5em;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose :global(img.float-left) {
				float: left;
				max-width: 50%;
				margin: 0.25em 1.5em 1em 0;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose :global(h2),
			.prose :global(h3) {
				clear: both;
			}
			@media (max-width: 720px) {
				.prose :global(img.float-right),
				.prose :global(img.float-left) {
					float: none;
					display: block;
					max-width: 100%;
					margin: 1em auto;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{resolvedHero && <Image width={1020} height={510} src={resolvedHero} alt={heroImageAlt ?? title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
